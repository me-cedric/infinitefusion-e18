--- a/src/binding.cpp
+++ b/src/binding.cpp
@@ patch: Static Ruby Linking
+// === EMSCRIPTEN RUBY LINKING PATCH ===
+//
+// Problem: mkxp-z loads Ruby via dlopen() at runtime.
+// Emscripten doesn't support dlopen (no dynamic linking for WASM).
+//
+// Solution: Link Ruby statically. Replace dlopen/dlsym with direct
+// symbol references resolved at link time.
+//
+// #ifdef __EMSCRIPTEN__
+// // Ruby is statically linked — no dlopen needed
+// #include <ruby.h>
+//
+// // Direct function calls instead of dlsym lookups:
+// // dlsym(handle, "ruby_init") → ruby_init()
+// // dlsym(handle, "rb_eval_string") → rb_eval_string()
+// // etc.
+//
