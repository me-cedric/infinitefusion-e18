@@ patch: HTTPLite Web Replacement
+// === EMSCRIPTEN HTTP PATCH ===
+//
+// Problem: HTTPLite uses native sockets (POSIX or WinHTTP) for HTTP.
+// Emscripten cannot use raw sockets — must use browser Fetch API.
+//
+// Solution: Replace HTTPLite::get() and HTTPLite::post_body() with
+// emscripten_fetch-backed implementations.
+//
+// #ifdef __EMSCRIPTEN__
+// #include <emscripten/fetch.h>
+//
+// VALUE httplite_get(VALUE self, VALUE url, VALUE headers) {
+//     emscripten_fetch_attr_t attr;
+//     emscripten_fetch_attr_init(&attr);
+//     attr.attributes = EMSCRIPTEN_FETCH_LOAD_TO_MEMORY | EMSCRIPTEN_FETCH_SYNCHRONOUS;
+//     strcpy(attr.requestMethod, "GET");
+//
+//     const char *c_url = StringValueCStr(url);
+//     emscripten_fetch_t *fetch = emscripten_fetch(&attr, c_url);
+//
+//     VALUE result = rb_hash_new();
+//     rb_hash_aset(result, ID2SYM(rb_intern("status")), INT2NUM(fetch->status));
+//     rb_hash_aset(result, ID2SYM(rb_intern("body")),
+//                  rb_str_new(fetch->data, fetch->numBytes));
+//
+//     emscripten_fetch_close(fetch);
+//     return result;
+// }
+// #endif
+//
+// CORS: Requests to external domains (infinitefusion.net, github.com) will
+// fail unless those servers send Access-Control-Allow-Origin headers.
+// The web build should configure CDN_BASE_URL to a same-origin mirror.
+
diff --git a/src/graphics.cpp b/src/graphics.cpp
--- a/src/graphics.cpp
+++ b/src/graphics.cpp
@@ patch: Canvas-Only Rendering
+// === EMSCRIPTEN GRAPHICS PATCH ===
+//
+// Problem: mkxp-z creates a native SDL window with resize/fullscreen.
+// On web, rendering targets an HTML5 <canvas> element.
+//
+// Solution:
+// 1. SDL_CreateWindow with SDL_WINDOW_OPENGL (Emscripten maps to canvas)
+// 2. Disable SDL_SetWindowFullscreen — CSS handles scaling
+// 3. Disable SDL_SetWindowSize for resize — canvas size set by HTML
+// 4. Keep OpenGL ES 2.0 context (maps to WebGL automatically)
+//
+// #ifdef __EMSCRIPTEN__
+// // Use the canvas element specified in shell.html
+// SDL_SetHint(SDL_HINT_EMSCRIPTEN_KEYBOARD_ELEMENT, "#canvas");
+//
+// // Disable native fullscreen, let CSS handle it
+// void Graphics::setFullscreen(bool) { /* no-op on web */ }
+//
+// // Screen resize handled by CSS + canvas scaling
+// void Graphics::setScale(double) { /* no-op on web */ }
+// #endif
+
